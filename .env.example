# ---------------------------------------------------------------
# Copy this file to ".env" and fill it in. Never share .env.
# ---------------------------------------------------------------

# Django
DJANGO_DEBUG=1
# Make a new one with:  python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=dev-only-insecure-key-change-me
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Admin's address (default admin/). Only superusers can use it; on a public server pick one nobody would guess.
DJANGO_ADMIN_PATH=admin/
DISPLAY_TIME_ZONE=Africa/Lagos

# HoduCC
HODU_BASE_URL=https://hoducc.roitechisl.com/HoduCC_api/v2.1
HODU_TOKEN=your_token_here
HODU_TENANT_ID=1005
HODU_TIME_ZONE=Africa/Lagos

# 1 = use the sample file in /sample instead of the real API (good for learning)
# 0 = call the real HoduCC API
HODU_MOCK=1

# Which call_status values count as "never answered"
HODU_UNANSWERED_STATUSES=ABANDONED,DROPPED

# Live mode: while the dashboard shows today, fetch new calls at most this often (seconds). 0 = off.
HODU_SYNC_ON_VIEW_SECONDS=60

# 1 = when someone looks at days the dashboard has never fetched (e.g. last year on the Monthly page),
#     fetch them from HoduCC in the background. 0 = off; then fill history with
#     python manage.py sync_calls --from 2026-01-01
HODU_AUTO_BACKFILL=1

# The dashboard warns when the last good sync is older than this many seconds.
# Keep it comfortably longer than the gap between syncs (900 suits a sync every 5 minutes).
HODU_STALE_AFTER_SECONDS=900

# ---------------------------------------------------------------
# Only for a real server (DJANGO_DEBUG=0). See "Going live" in the guide (Part 5).
# ---------------------------------------------------------------
# The site's own https address
#DJANGO_CSRF_TRUSTED_ORIGINS=https://dashboard.yourcompany.com
# 1 if nginx/IIS/your host sits in front and sets the X-Forwarded-Proto header
#DJANGO_BEHIND_PROXY=1
# 1 = send http:// visitors to https://
#DJANGO_SSL_REDIRECT=1
# Tell browsers to use https only, for this many seconds. Start small (3600), raise it once all is well.
#DJANGO_HSTS_SECONDS=3600

# --- Forgot password (see "Forgot password" in README.md) ---
# Reset links go only to addresses on this domain
PASSWORD_RESET_EMAIL_DOMAIN=dash-mfb.com
# The address people open the dashboard at; reset links point there
#DJANGO_PUBLIC_URL=https://calls.dash-mfb.com
# Send the emails through Microsoft 365 (an app registered in Azure with the Mail.Send application permission)...
#MSGRAPH_TENANT_ID=
#MSGRAPH_CLIENT_ID=
#MSGRAPH_CLIENT_SECRET=
#MSGRAPH_SENDER=no-reply@dash-mfb.com
# ...or through an ordinary mail server (SMTP). With neither, emails are printed in the server's console.
#EMAIL_HOST=smtp.office365.com
#EMAIL_PORT=587
#EMAIL_HOST_USER=no-reply@dash-mfb.com
#EMAIL_HOST_PASSWORD=
#DEFAULT_FROM_EMAIL=no-reply@dash-mfb.com
